# Python virtual environment (isolated deps — do not commit)
.venv/
venv/
env/

# Environment secrets
backend/.env
.env
*.env.local

# Bytecode / caches
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Next.js
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/tsconfig.tsbuildinfo

# Local API persistence (user-specific; recreated by backend)
backend/data/history_store.json

# Local audit / batch eval outputs (may contain prompt snippets)
backend/logs/*.jsonl
backend/app/logs/
backend/evaluation/results/

# Local eval/memory artifacts
data/eval/
data/memory/
backend/data/users.db
