# Copy this file to backend\.env (never commit .env).
# Use a project virtual environment: from repo root run
#   python -m venv .venv
# then activate and pip install -r backend\requirements.txt
# Run uvicorn from repo root (see README).

APP_NAME=StockScope API
APP_ENV=dev
APP_DEBUG=true

# Provider: yfinance | finnhub | alpha_vantage
MARKET_DATA_PROVIDER=yfinance

# Optional API keys — Layer 1 buy/sell bundle (see docs/Layer1-api-call-ledger.md)
# Alpha Vantage: NEWS_SENTIMENT (news + sentiment), 1 call per ticker when set.
ALPHA_VANTAGE_API_KEY=
# Finnhub: stock recommendation trends, 1 call per ticker when set. If empty, analyst
# consensus comes from yfinance info (same info() call — no extra HTTP).
FINNHUB_API_KEY=
# Financial Modeling Prep — optional future use (DCF / statements); Layer 1 does not call yet.
FMP_API_KEY=

# Buy/Sell LLM review (Phase 4)
# Set provider to huggingface for FinGPT-style hosted inference.
BUYSELL_LLM_PROVIDER=none
BUYSELL_LLM_ENABLED=false
BUYSELL_LLM_MODEL=
BUYSELL_LLM_TIMEOUT_SECONDS=45

# Hugging Face (generic inference API and/or dedicated endpoint URL)
HUGGINGFACE_API_TOKEN=
HF_MODEL_ID=
HF_INFERENCE_URL=

# Polygon.io — used by scripts/fetch_universes_polygon.py to validate tickers / names
# (Polygon does not provide index constituent lists via REST; see README.)
POLYGON_API_KEY=

# Browser origins allowed to call this API (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Market movers snapshot cache (in-process). Same key = same yfinance batch until TTL.
MOVERS_CACHE_ENABLED=true
MOVERS_CACHE_TTL_INTRADAY_SECONDS=60
MOVERS_CACHE_TTL_PREVIOUS_DAY_SECONDS=300

# --- Fundamental analysis AI (include_llm=true): Gemini + Ollama ---
# Google Gemini (Generative Language API / AI Studio). Fundamentals UI default: gemini-3-flash-preview.
GEMINI_API_KEY=

# Local Ollama HTTP base (no trailing slash). Used when provider=ollama.
OLLAMA_BASE_URL=http://localhost:11434

# Phase 5.1 — RAG embeddings (Hugging Face Inference API; same token as LLM) + chunk store limits
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=16
RAG_BM25_WEIGHT=0.45
RAG_EMBEDDING_WEIGHT=0.55
# Max age in days for retrieval (published_at when parseable). Use -1 to disable filtering by default.
RAG_MAX_CHUNK_AGE_DAYS=730
RAG_MAX_TOTAL_CHUNKS=80000
RAG_MAX_CHUNKS_PER_TICKER=600
# Rotate chunks.jsonl to an archive when file size exceeds this (bytes); clears per-ticker embedding npz.
RAG_ROTATE_BYTES=104857600

# SEC EDGAR — required descriptive User-Agent (see https://www.sec.gov/os/accessing-edgar-data)
SEC_EDGAR_ENABLED=true
SEC_USER_AGENT=YourName your.email@example.com
SEC_FILINGS_LIMIT=2
SEC_FILING_MAX_DOWNLOAD_CHARS=200000
SEC_CIK_CACHE_HOURS=168
SEC_REQUEST_DELAY_SECONDS=0.15

# Phase 7 — session memory (file: StockScope/data/memory/sessions.json)
MEMORY_ENABLED=true
MEMORY_MAX_RECENT_TICKERS=30

# Phase 8 — eval output directory override (optional; default data/eval/)
EVAL_OUTPUT_DIR=
