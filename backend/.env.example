# StockScope — backend environment configuration
# ─────────────────────────────────────────────
# 1. Copy this file:   cp backend/.env.example backend/.env
# 2. Fill in the keys marked with  ← REQUIRED  or  ← OPTIONAL
# 3. Never commit .env to version control.
#
# Setup checklist:
#   a) Install Ollama from https://ollama.com and pull the models (see README).
#   b) Obtain a Gemini API key from https://aistudio.google.com/app/apikey
#   c) (Optional) HuggingFace token from https://huggingface.co/settings/tokens
#   d) Run:  uvicorn app.main:app --reload   from backend/

APP_NAME=StockScope API
APP_ENV=dev
APP_DEBUG=true

# ── Authentication (JWT) ─────────────────────────────────────────────────────
# Generate with:  python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-replace-with-random-64-char-hex  # ← CHANGE THIS
JWT_EXPIRE_HOURS=24

# ── LLM: Gemini (primary) ────────────────────────────────────────────────────
# Required for AI-powered features (chatbot, news themes, buy/sell rationale,
# fundamental explanation, multi-model comparison).
GEMINI_API_KEY=                          # ← REQUIRED
GEMINI_MODEL=gemini-1.5-flash

# ── LLM: Ollama (local fallback) ─────────────────────────────────────────────
# Run:  ollama pull llama3.1:8b
#       ollama pull mistral:7b
#       ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLAMA_MODEL=llama3.1:8b
OLLAMA_MISTRAL_MODEL=mistral:7b

# ── Sentiment: HuggingFace / FinBERT ─────────────────────────────────────────
# Optional — keyword-based fallback used when absent.
HUGGINGFACE_API_KEY=                     # ← OPTIONAL
HF_MODEL_ID=ProsusAI/finbert
FINBERT_ENABLED=true

# ── Market data (optional enrichment) ────────────────────────────────────────
MARKET_DATA_PROVIDER=yfinance
ALPHA_VANTAGE_API_KEY=                   # ← OPTIONAL  (news + sentiment feed)
FINNHUB_API_KEY=                         # ← OPTIONAL  (company news)

# ── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── Buy/Sell LLM review ───────────────────────────────────────────────────────
# Enabled by default — LLMService (Gemini → LLaMA → Mistral) generates a plain-
# English explanation of the deterministic buy/sell score.
BUYSELL_LLM_PROVIDER=gemini
BUYSELL_LLM_ENABLED=true
BUYSELL_LLM_TIMEOUT_SECONDS=45

# ── Market movers cache ───────────────────────────────────────────────────────
MOVERS_CACHE_ENABLED=true
MOVERS_CACHE_TTL_INTRADAY_SECONDS=60
MOVERS_CACHE_TTL_PREVIOUS_DAY_SECONDS=300

# ── RAG / embeddings ──────────────────────────────────────────────────────────
RAG_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RAG_EMBEDDING_BATCH_SIZE=16
RAG_BM25_WEIGHT=0.45
RAG_EMBEDDING_WEIGHT=0.55
RAG_MAX_CHUNK_AGE_DAYS=730
RAG_MAX_TOTAL_CHUNKS=80000
RAG_MAX_CHUNKS_PER_TICKER=600
RAG_ROTATE_BYTES=104857600

# ── SEC EDGAR (optional filing ingestion) ────────────────────────────────────
SEC_EDGAR_ENABLED=true
SEC_USER_AGENT=YourName your.email@example.com
SEC_FILINGS_LIMIT=2
SEC_FILING_MAX_DOWNLOAD_CHARS=200000
SEC_CIK_CACHE_HOURS=168
SEC_REQUEST_DELAY_SECONDS=0.15

# ── Session memory ────────────────────────────────────────────────────────────
MEMORY_ENABLED=true
MEMORY_MAX_RECENT_TICKERS=30

# ── Eval output directory (optional override) ─────────────────────────────────
EVAL_OUTPUT_DIR=
